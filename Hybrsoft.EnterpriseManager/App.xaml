<?xml version="1.0" encoding="utf-8"?>
<Application
	x:Class="Hybrsoft.EnterpriseManager.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:Hybrsoft.EnterpriseManager.Converters">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
				<ResourceDictionary Source="/Controls/Buttons/CopyButton.xaml" />
				<ResourceDictionary Source="/Styles/Buttons.xaml" />
				<ResourceDictionary Source="/Styles/Cards.xaml" />
				<ResourceDictionary Source="/Styles/DataGrid.xaml" />
				<ResourceDictionary Source="/Styles/Sections.xaml" />
				<ResourceDictionary Source="/Styles/ToolBar.xaml" />
				<!-- Other merged dictionaries here -->
			</ResourceDictionary.MergedDictionaries>
			<!-- Column Widths -->
			<GridLength x:Key="ColumnWidthCurrency">120</GridLength>
			<GridLength x:Key="ColumnWidthDate">160</GridLength>
			<GridLength x:Key="ColumnWidthIcon">32</GridLength>
			<GridLength x:Key="ColumnWidthID">180</GridLength>
			<GridLength x:Key="ColumnWidthNumberDocument">160</GridLength>
			<GridLength x:Key="ColumnWidthPhone">140</GridLength>
			<GridLength x:Key="ColumnWidthPicture">40</GridLength>
			<GridLength x:Key="ColumnWidthShortNumber">60</GridLength>
			<GridLength x:Key="ColumnWidthStatus">160</GridLength>
			<GridLength x:Key="ColumnWidthTime">70</GridLength>
			<GridLength x:Key="ColumnWidthType">140</GridLength>
			<GridLength x:Key="ColumnWidthYear">80</GridLength>
			<!-- Other app resources here -->
			<SolidColorBrush x:Key="DetailsViewBackgroundColor" Color="#F5F5F5" />
			<!--  Converters  -->
			<converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" FalseValue="Visible" TrueValue="Collapsed" />
			<converters:BoolToVisibilityConverter x:Key="DefaultBoolToVisibilityConverter" FalseValue="Collapsed" TrueValue="Visible" />
			<converters:BoolNegationConverter x:Key="BoolNegationConverter" />
			<converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter" />
			<converters:Int16Converter x:Key="Int16Converter" />
			<converters:LogTypeConverter x:Key="LogTypeConverter" />
			<converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
			<converters:ObjectToImageConverter x:Key="ObjectToImageConverter" />
			<converters:SubscriptionTypeConverter x:Key="SubscriptionTypeConverter" />
			<converters:LostAndFoundStatusConverter x:Key="LostAndFoundStatusConverter" />
			<converters:DataLayoutConverter x:Key="DataLayoutConverter" />
		</ResourceDictionary>
	</Application.Resources>
</Application>
